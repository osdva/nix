// niri config.
// Linked to ~/.config/niri/config.kdl by home-manager; niri reloads it on save.
// Check: `niri validate`. Reference: https://github.com/YaLTeR/niri/wiki

input {
    keyboard {
        xkb {
            layout "br,us"
            variant "thinkpad,"
            options "grp:alt_shift_toggle"
        }
        repeat-delay 600
        repeat-rate 25
        numlock
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    mouse {
        natural-scroll
    }

    // Sloppy focus, without scrolling the strip when the pointer crosses into
    // a partly visible column.
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

cursor {
    xcursor-size 24
}

// niri picks a fractional scale for HiDPI panels (1.25 here); keep it native.
output "eDP-1" {
    scale 1
}

// --- Layout ---------------------------------------------------------------------
// Columns scroll horizontally; workspaces stack vertically and are created as
// needed (there is always an empty one at the bottom).
layout {
    gaps 5
    center-focused-column "never"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000077"
    }
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

prefer-no-csd
hotkey-overlay {
    skip-at-startup
}

environment {
    XCURSOR_SIZE "24"
    QT_QPA_PLATFORM "wayland;xcb"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// --- Binds ------------------------------------------------------------------------
// Touchpad gestures are built in: 3-finger swipe left/right scrolls columns,
// up/down switches workspaces; 4-finger swipe opens the overview.
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+T { spawn "kitty"; }
    Mod+E { spawn "nautilus"; }
    Mod+B { spawn "firefox"; }
    Mod+P { spawn "bitwarden"; }
    Mod+N { spawn "obsidian"; }
    Mod+M { spawn "cider-2"; }

    // Noctalia
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Alt+L allow-when-locked=true { spawn-sh "noctalia msg session lock"; }
    Mod+Alt+S { spawn-sh "pkill orca || exec orca"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // Window management
    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+E { quit; }

    // Focus (arrows + hjkl). Up/down cross into the next workspace at the
    // top/bottom of a column.
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+J { focus-window-or-workspace-down; }

    // Move windows (same edge behaviour as focus)
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Down { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+K { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+J { move-window-down-or-to-workspace-down; }

    // Stack a window into the neighbouring column, or pop it back out
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // Monitors
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Workspaces (vertical)
    Mod+Shift+Up { focus-workspace-up; }
    Mod+Shift+Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }

    // Mouse wheel: Mod scrolls workspaces, Mod+Shift scrolls columns.
    // Mod+drag moves a window, Mod+right-drag resizes it (built in).
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }

    // Screenshots (Noctalia)
    Print { spawn-sh "noctalia msg screenshot-region"; }
    Ctrl+Print { spawn-sh "noctalia msg screenshot-fullscreen"; }
}
